<div class="block_youtube_videos_container customSlider font-size14px">
    <div class="bg-white rounded-4 p-3 h-100 position-relative">
        <div class="bg-blue100 text-blue p-3 rounded-3 d-flex justify-content-between align-items-center">
            <div class="position-relative d-flex align-items-center gap-3 flex-grow-1">
                <div class="serchIcon flex-grow-1">
                    <svg class="search-icon-svg" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.5 11H11.71L11.43 10.73C12.41 9.59 13 8.11 13 6.5C13 2.91 10.09 0 6.5 0C2.91 0 0 2.91 0 6.5C0 10.09 2.91 13 6.5 13C8.11 13 9.59 12.41 10.73 11.43L11 11.71V12.5L16 17.49L17.49 16L12.5 11ZM6.5 11C4.01 11 2 8.99 2 6.5C2 4.01 4.01 2 6.5 2C8.99 2 11 4.01 11 6.5C11 8.99 8.99 11 6.5 11Z" fill="#7F7F7F"/>
                    </svg>
                    <input type="text" 
                           id="{{searchinputid}}"
                           class="form-control font-Regular w-100" 
                           placeholder="{{#str}}search_videos, block_youtube_videos{{/str}}" 
                           aria-label="Search">
                </div>
                <div class="d-flex gap-3">
                    <!-- Navigation Buttons -->
                    <div class="swiperNew-button-prev {{buttonprevclass}}">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7.5 9L4.5 6L7.5 3" stroke="#033e87" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="swiperNew-button-next {{buttonnextclass}}">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4.5 3L7.5 6L4.5 9" stroke="#033e87" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="pt-3">
            <div id="{{swiperid}}" class="swiper">
                <div class="swiper-wrapper">
                    {{#slides}}
                    <div class="swiper-slide">
                        {{#.}}
                        <div class="d-flex align-items-center justify-content-between mb-3 gap3">
                            <figure class="mb-0 d-flex align-items-center gap-3">
                                <img src="{{imageurls.thumbnail_base}}{{thumbnail}}" alt="{{title}}" style="max-width: 100px; height: auto;">
                                <figcaption>
                                    <h6 class="text-black mb-2">{{title}}</h6>
                                    <p class="mb-0 font-Regular">{{description}}</p>
                                </figcaption>
                            </figure>
                            <div>
                                <button class="btn video-play-btn" 
                                        type="button" 
                                        data-video-url="{{url}}"
                                        title="{{#str}}play_video, block_youtube_videos{{/str}}">
                                    <img src="{{imageurls.play_button}}" alt="Play" height="35">
                                </button>
                            </div>
                        </div>
                        {{/.}}
                    </div>
                    {{/slides}}
                </div>
            </div>
        </div>
    </div>
</div>
